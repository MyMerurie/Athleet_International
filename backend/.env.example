# Copy to .env (git-ignored) and fill in. Never commit real values.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/athleet
DB_USERNAME=athleet
DB_PASSWORD=change-me
# Base64 of at least 32 random bytes, e.g.:  openssl rand -base64 48
JWT_SECRET=+qFJlWUUe6dxM3IWeNnNv7X5cJMxkOE8uWYqoLjmCdkva8w817CKiSpL8XZkCS8T
WEB_BASE_URL=http://localhost:5173
# File uploads (attendance selfies). The dev profile uses local storage; leave STORAGE_PROVIDER unset to use it.
# STORAGE_URL_SECRET is required when storage is enabled: at least 32 random characters, e.g.  openssl rand -base64 48
STORAGE_URL_SECRET=
# Folder for uploaded files. Defaults to ~/.athleet/files. Keep it outside the repository.
STORAGE_LOCAL_ROOT=
# Creates the first platform admin when the database has no users (password: 12+ characters). Remove after first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
